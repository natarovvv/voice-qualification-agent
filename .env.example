# All optional. With none of them set the server still runs:
# offline LLM script + local whisper (or nothing) + free edge-tts.

# One key, both directions: Nova-2 transcribes and Aura speaks. Without it the
# voice falls back to edge-tts, which has no commercial agreement behind it and
# is for development only.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- who may open a call ---
# Comma-separated origins allowed to open /ws. A websocket is exempt from the
# same-origin policy, so this list is the only thing between your API budget
# and the whole internet. "*" turns the check off; do not ship that.
# ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for /ws; must match NEXT_PUBLIC_WS_TOKEN in web/.env.local.
# Required in practice as soon as HOST is not loopback.
# AUTH_TOKEN=

# HOST=127.0.0.1           # 0.0.0.0 exposes the port; set AUTH_TOKEN first
# PORT=8000
# DEV=1                    # uvicorn auto-reload; development only
# MAX_CALLS=20             # concurrent websockets

# Shared session store. Unset keeps the process-local dict, which is what a
# single worker wants anyway. Read the note in session.py first: this makes an
# interrupted call recoverable, it does not make a second worker safe - the
# JSON file storage in tools.py is what stops that.
# REDIS_URL=redis://localhost:6379/0

# How long a call whose socket died stays resumable before its record is
# written. A dropped connection is not a hangup - a tunnel dies, a phone
# changes network, a tab reloads - and ending the call there loses everything
# said so far. 0 goes back to ending the call on every disconnect.
# RESUME_GRACE=60

# Leads and bookings. Unset keeps the JSON files, which need no setup and are
# safe for exactly one worker. This is the one that makes a second worker safe:
# "is this slot free" stops being a lock and becomes a database constraint.
# DATABASE_URL=postgresql://user:pass@localhost:5432/voice_agent

# Call transcripts are personal data. Records older than this are deleted at
# startup; 0 keeps them forever, which is a liability rather than a feature.
# CALL_RETENTION_DAYS=30

# LLM_PROVIDER=groq          # groq | gemini; blank picks the fastest key you have
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# WHISPER_MODEL=tiny.en
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en   # the Aura voice; model name is the voice
# TTS_VOICE=en-US-AriaNeural            # edge-tts fallback voice only
# SESSION_TTL=1800

# Echo guard: how hard to ignore the agent's own voice coming back off the
# speakers. 0.5 disables the duck (right for a headset); raise ECHO_START_MS
# or ECHO_TAIL_MS in a room where the speakers are loud.
# ECHO_THRESHOLD=0.85
# ECHO_START_MS=400
# ECHO_TAIL_MS=250
